    "error.size": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This file or code is too large. Share long letters as files."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件或口令太大。发送长信时，请使用来信附件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檔案或代碼太大。傳送長信時，請使用來信附件。"}}}},
    "error.duplicate": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This family letter has already been imported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这封亲友来信已经导入过。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這封親友來信已經匯入過。"}}}},
    "error.storage": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Check available storage and try again. Your saved letters are still in the app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查可用空间后重试。已保存的信仍留在 App 内。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請檢查可用空間後再試一次。已儲存的信仍留在 App 內。"}}}},
    "error.photo": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The photo couldn’t be read. Try another photo or save without one."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"照片暂时无法读取。可换一张，或先保存文字。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片暫時無法讀取。可換一張，或先儲存文字。"}}}},
    "error.notification": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The date was kept, but the notification couldn’t be scheduled. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期已保留，通知暂时未能设置。请重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"日期已保留，通知暫時無法設定。請再試一次。"}}}},
    "error.purchase": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The App Store could not complete this step. Try again when you’re online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App Store 暂未完成此操作。请联网后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App Store 暫未完成此操作。請連上網路後再試一次。"}}}},
    "error.clipboard": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy a letter code from your family chat first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先从家庭聊天中复制来信口令。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先從家庭聊天中複製來信代碼。"}}}},
    "sample.0": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dear Mia,\n\nYou called your boots “puddle shoes” today. We took the long way home so you could find one more puddle.\n\nLove, Mom"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"亲爱的 Mia，\n\n今天你把雨靴叫作「踩水鞋」。我们特地绕了远路回家，让你再找一滩水踩。\n\n爱你的妈妈"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"親愛的 Mia，\n\n今天你把雨靴叫作「踩水鞋」。我們特地繞了遠路回家，讓你再找一灘水踩。\n\n愛你的媽媽"}}}},
    "sample.1": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The porch light\nYou waved at every pumpkin on the way home."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"门廊的灯\n回家路上，你跟每一只南瓜都打了招呼。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"門廊的燈\n回家路上，你跟每一個南瓜都打了招呼。"}}}},
    "sample.2": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your blue cup\nYou chose it yourself this morning."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的蓝杯子\n今天早上是你自己选的。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"你的藍杯子\n今天早上是你自己選的。"}}}},
    "sample.3": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Rain on the window\nWe listened until you fell asleep."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"窗上的雨\n我们听着雨，直到你睡着。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"窗上的雨\n我們聽著雨，直到你睡著。"}}}},
    "sample.4": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A small shell\nYou kept it in your pocket all afternoon."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一枚小贝壳\n你把它放在口袋里一整个下午。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一枚小貝殼\n你把它放在口袋裡一整個下午。"}}}},
    "sample.5": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Two strawberries\nYou saved the bigger one for Theo."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"两颗草莓\n你把更大的那颗留给了 Theo。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"兩顆草莓\n你把比較大的那顆留給了 Theo。"}}}},
    "sample.6": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The paper boat\nWe watched it turn the corner."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"纸船\n我们看着它漂过转角。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"紙船\n我們看著它漂過轉角。"}}}},
    "sample.7": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A quiet Sunday\nWe read the same book three times."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安静的星期天\n同一本书，我们读了三遍。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安靜的星期天\n同一本書，我們讀了三遍。"}}}},
    "sample.8": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The yellow leaf\nYou brought it home for our table."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一片黄叶\n你把它带回家，放到了餐桌上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一片黃葉\n你把它帶回家，放到了餐桌上。"}}}},
    "sample.9": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"One candle for you\nYou clapped before we finished singing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"给你的一根蜡烛\n我们还没唱完，你就拍起了手。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"給你的一根蠟燭\n我們還沒唱完，你就拍起了手。"}}}},
    "sample.family": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dear Mia,\n\nI still remember the first time you reached up for my hand. I hope we get to walk together again soon.\n\nLove, Grandma"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"亲爱的 Mia，\n\n我还记得你第一次伸手来牵我。希望我们很快又能一起散步。\n\n外婆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"親愛的 Mia，\n\n我還記得你第一次伸手來牽我。希望我們很快又能一起散步。\n\n外婆"}}}},
    "sample.grandma": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Grandma"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外婆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"外婆"}}}}
  },
  "version": "1.0"
}
